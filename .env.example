# Copy this file to .env. Never put real secrets in this tracked template.
RUNWAYML_API_SECRET=
ELEVENLABS_API_KEY=
# Optional separately billed transcription is disabled on the public demo by default.
RIPPLE_ENABLE_TRANSCRIPTION=false

# Account-specific Runway workflow/router identifiers.
RUNWAY_TALKING_WORKFLOW_ID=
RUNWAY_SEEDANCE2_WORKFLOW_ID=
RUNWAY_SEEDANCE25_WORKFLOW_ID=
RUNWAY_HAILUO3_WORKFLOW_ID=
RUNWAY_PRODUCT_CLONE_WORKFLOW_ID=
RUNWAY_SEEDANCE_ROUTER_CONFIG_ID=

# Hosting and local storage.
RIPPLE_ACCESS_PASSWORD=
RIPPLE_MAX_UPLOAD_MIB=256
RIPPLE_DATA_DIR=.cutdetect/pipeline_studio
RIPPLE_CACHE_DIR=.cutdetect/cache
